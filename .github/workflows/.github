<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Pro Ultra Camera & Editor</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: #000; color: #fff; font-family: -apple-system, sans-serif; display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
        
        /* ক্যামেরা স্ক্রিন */
        .viewport { flex: 1; position: relative; background: #000; display: flex; justify-content: center; align-items: center; overflow: hidden; }
        video { width: 100%; height: 100%; object-fit: cover; transition: transform 0.05s linear, filter 0.2s ease; }
        
        /* ব্লার বা প্রফেশনাল পোর্ট্রেট ইফেক্ট ওভারলে */
        .blur-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; backdrop-filter: blur(8px); pointer-events: none; opacity: 0; transition: opacity 0.3s; }
        .blur-active .blur-overlay { opacity: 1; }

        /* ইউজার ইন্টারফেস ও কন্ট্রোল */
        .controls { height: 220px; background: rgba(0, 0, 0, 0.9); display: flex; flex-direction: column; justify-content: space-around; padding: 15px; border-top: 1px solid #222; }
        
        .row { display: flex; justify-content: space-between; align-items: center; width: 100%; }
        
        .zoom-box { display: flex; align-items: center; gap: 8px; width: 55%; background: #111; padding: 6px 12px; border-radius: 20px; }
        .zoom-box input { width: 100%; accent-color: #f1c40f; }
        
        select, button { background: #222; color: #fff; border: 1px solid #444; padding: 8px 12px; border-radius: 8px; font-size: 13px; outline: none; }
        
        .btn-shutter { width: 70px; height: 70px; border-radius: 50%; border: 4px solid #fff; background: #e74c3c; cursor: pointer; }
        .btn-shutter:active { transform: scale(0.9); }
        .active-mode { border-color: #f1c40f; color: #f1c40f; }
    </style>
</head>
<body>

    <div class="viewport" id="camViewport">
        <video id="cameraFeed" autoplay playsinline></video>
        <div class="blur-overlay"></div>
    </div>

    <div class="controls">
        <!-- জুম ও ফিল্টার অপশন -->
        <div class="row">
            <div class="zoom-box">
                <span style="font-size: 11px;">🔍 <b id="zoomText">1x</b></span>
                <input type="range" id="zoomSlider" min="1" max="1000" step="1" value="1" oninput="updateZoom(this.value)">
            </div>
            
            <select id="modeSelect" onchange="applyMode()">
                <option value="none">📸 Normal Mode</option>
                <option value="brightness(160%) contrast(120%) saturate(110%)">🌙 Night Ultra</option>
                <option value="contrast(130%) saturate(140%)">🎨 Vivid Color</option>
                <option value="grayscale(100%)">🖤 HDR B&W</option>
            </select>
        </div>

        <!-- পোর্ট্রেট ব্লার ও স্পিড কন্ট্রোল -->
        <div class="row">
            <button id="blurBtn" onclick="toggleBlur()">✨ Portrait Blur (Off)</button>
            <button id="speedBtn" onclick="toggleSpeed()">⚡ Speed: 1.0x</button>
        </div>

        <!-- শাটার ও সুইচ বাটন -->
        <div class="row" style="justify-content: space-around;">
            <button onclick="switchCamera()">🔄 Flip</button>
            <button class="btn-shutter" onclick="takeHighResSnap()"></button>
            <button onclick="alert('ভিডিও প্রসেসিং শুরু হয়েছে!')">📹 Record</button>
        </div>
    </div>

    <canvas id="hdrCanvas" style="display:none;"></canvas>

    <script>
        const video = document.getElementById('cameraFeed');
        const viewport = document.getElementById('camViewport');
        const canvas = document.getElementById('hdrCanvas');
        let currentFacing = 'environment';
        let isBlur = false;
        let speed = 1.0;

        // অরিজিনাল ফোন ক্যামেরা চালু করা
        function startCamera(facing) {
            navigator.mediaDevices.getUserMedia({ 
                video: { facingMode: facing, width: { ideal: 3840 }, height: { ideal: 2160 } }, 
                audio: true 
            })
            .then(stream => { video.srcObject = stream; })
            .catch(err => { alert("ক্যামেরা ওপেন করা সম্ভব হয়নি! ডিভাইসের পারমিশন চেক করুন।"); });
        }

        startCamera(currentFacing);

        function switchCamera() {
            currentFacing = (currentFacing === 'environment') ? 'user' : 'environment';
            if (video.srcObject) {
                video.srcObject.getTracks().forEach(track => track.stop());
            }
            startCamera(currentFacing);
        }

        function updateZoom(val) {
            document.getElementById('zoomText').innerText = val + 'x';
            video.style.transform = `scale(${val})`;
        }

        function applyMode() {
            video.style.filter = document.getElementById('modeSelect').value;
        }

        function toggleBlur() {
            isBlur = !isBlur;
            viewport.classList.toggle('blur-active', isBlur);
            document.getElementById('blurBtn').innerText = isBlur ? "✨ Portrait Blur (ON)" : "✨ Portrait Blur (Off)";
        }

        function toggleSpeed() {
            speed = speed === 1.0 ? 2.0 : (speed === 2.0 ? 0.5 : 1.0);
            document.getElementById('speedBtn').innerText = `⚡ Speed: ${speed}x`;
        }

        function takeHighResSnap() {
            const ctx = canvas.getContext('2d');
            canvas.width = video.videoWidth || 1920;
            canvas.height = video.videoHeight || 1080;
            ctx.filter = document.getElementById('modeSelect').value;
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
            
            const link = document.createElement('a');
            link.href = canvas.toDataURL("image/png");
            link.download = `Pro_Camera_${Date.now()}.png`;
            link.click();
        }
    </script>
</body>
</html>
